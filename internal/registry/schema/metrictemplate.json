{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mizan.dev/schema/metrictemplate.json",
  "title": "Mizan MetricTemplate pack manifest",
  "description": "STRICT structural schema for a pack MetricTemplate file (design §3.5, P2.2). This is the creds-free PR gate: additionalProperties:false catches misspelled keys (the codec's tolerant KnownFields(false) stays for import; `pack validate` is the strict boundary). The spec.kind enum lists all six tokens incl. the vernacular single/compare (design §3.2); the codec canonicalizes via NormalizeKind.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["mizan.dev/v1alpha1"]
    },
    "kind": {
      "type": "string",
      "const": "MetricTemplate"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "email": { "type": "string" }
            }
          }
        },
        "maintainers": { "type": "array", "items": { "type": "string" } },
        "license": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "description": "Accepts vernacular single/compare and canonical pointwise/pairwise/rubric/custom_schema (design §3.2); the codec canonicalizes via NormalizeKind.",
          "enum": ["single", "pointwise", "compare", "pairwise", "rubric", "custom_schema"]
        },
        "modalities": {
          "type": "array",
          "items": { "type": "string", "enum": ["text", "image", "audio", "video", "music"] }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "modality": { "type": "string", "enum": ["text", "image", "audio", "video", "music"] },
              "required": { "type": "boolean" }
            }
          }
        },
        "metricPromptTemplate": { "type": "string" },
        "systemInstruction": { "type": "string" },
        "candidateFieldName": { "type": "string" },
        "baselineFieldName": { "type": "string" },
        "rubricGroups": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "responseSchema": { "type": "object" },
        "ratingRubric": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "rubricDetail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scale": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": { "type": "integer" },
                "max": { "type": "integer" }
              }
            }
          }
        },
        "rubricProvenance": {
          "type": "object",
          "description": "OPTIONAL adaptive-generation provenance (design §4.4). Absent means hand-authored. Included in the content hash (Decision 3).",
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "maxLength": 256 },
            "generatorModel": { "type": "string", "maxLength": 256 },
            "recipe": { "type": "string", "maxLength": 256 },
            "promptTemplate": { "type": "string", "maxLength": 8192 },
            "sampleInputRef": { "type": "string", "maxLength": 4096 },
            "generatedAt": { "type": "string", "format": "date-time" },
            "apiVersion": { "type": "string", "maxLength": 256 },
            "rubricMeta": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "group": { "type": "string", "maxLength": 128 },
                  "criterion": { "type": "string", "maxLength": 4096 },
                  "type": { "type": "string", "maxLength": 128 },
                  "importance": { "type": "string", "maxLength": 128 }
                }
              }
            }
          }
        },
        "autorater": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string" },
            "samplingCount": { "type": "integer" },
            "flipEnabled": { "type": "boolean" }
          }
        }
      }
    }
  }
}
